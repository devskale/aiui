{
  "name": "piui",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"pnpm run dev:server\" \"pnpm run dev:client\"",
    "dev:server": "node --watch server/index.js",
    "dev:client": "vite",
    "build": "vite build",
    "test": "node --test extensions/*.test.js server/*.test.js shared/*.test.js src/lib/*.test.js scripts/*.test.js",
    "e2e": "node scripts/agent-e2e.js",
    "e2e:slow": "node scripts/agent-e2e.js --slow",
    "check:sdk": "node scripts/check-sdk-exports.js",
    "smoke": "node scripts/smoke.js",
    "smoke:full": "node scripts/smoke.js --full",
    "prepare": "husky"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "^0.99.2",
    "concurrently": "^10.0.5",
    "express": "^5.2.1",
    "lucide-react": "^1.49.0",
    "multer": "^2.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "husky": "^9.1.7",
    "vite": "^8.3.1"
  }
}
